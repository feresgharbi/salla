{#
RIHA footer: centred logo and tagline, then the merchant's footer menu,
contacts and social links, then payments and the copyright line.
Everything that Salla manages (menus, contacts, VAT, trust badges, payments)
is still rendered by Salla's own components, so it stays in sync with the dashboard.
#}
{% set text_logo = theme.settings.get('riha_text_logo', true) %}
<footer data-testid="store-footer" class="store-footer riha-footer">
  <div class="container">
    <div class="riha-footer__top">
      <a href="{{ link('/') }}" class="riha-logo riha-logo--lg" aria-label="{{ store.name }}">
        {% if text_logo %}
          <b>{{ theme.settings.get('riha_logo_text', 'RIHA') }}</b>
          {% if theme.settings.get('riha_logo_tagline', 'Maison de parfum') %}
            <small>{{ theme.settings.get('riha_logo_tagline', 'Maison de parfum') }}</small>
          {% endif %}
        {% else %}
          <img loading="lazy" src="{{ store.logo|cdn(240) }}" alt="{{ store.name }}">
        {% endif %}
      </a>
      {% set tagline = theme.settings.get('riha_footer_tagline') %}
      {% if tagline %}
        <p>{{ tagline }}</p>
      {% elseif store.description %}
        <div class="riha-footer__desc">{{ store.description|raw }}</div>
      {% endif %}
      <salla-social data-testid="store-footer-social" class="riha-footer__social"></salla-social>
    </div>

    <div class="riha-footer__grid">
      <div>
        <h4>{{ trans('blocks.footer.pages_links') }}</h4>
        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
      </div>

      <div>
        <salla-contacts data-testid="store-footer-contacts"></salla-contacts>
      </div>

      <div class="riha-footer__trust">
        <salla-trust-badges data-testid="store-footer-trust-badges"></salla-trust-badges>
        {% if store.settings.tax.number %}
          <div class="riha-footer__vat">
            {% if store.settings.tax.certificate %}
              <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" aria-label="{{ trans('common.elements.tax_number') }}">
                <img width="40" height="50" src="{{ 'images/tax.png'|cdn(70,70) }}" loading="lazy" alt="VAT">
              </a>
            {% endif %}
            <div>
              <small>{{ trans('common.elements.tax_number') }}</small>
              <b>{{ store.settings.tax.number }}</b>
            </div>
          </div>
          {% if store.settings.tax.certificate %}
            <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
              <div class="flex justify-center max-w-full">
                <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}
        <salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>
      </div>
    </div>

    <div class="riha-footer__bottom">
      <span class="copyright-text">{% hook copyright %}</span>
      <salla-payments data-testid="store-footer-payments"></salla-payments>
    </div>
  </div>
</footer>
