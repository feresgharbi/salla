{% include 'components.home.riha.heritage' with {component: {"image": "https://images.unsplash.com/photo-1509228105826-2d09109f16bc?auto=format&fit=crop&w=1400&q=80", "title": "من تونس إلى الرياض", "year_1": "2021", "place_1": "تونس", "year_2": "2026", "place_2": "الرياض", "text": "وُلدت الدار في قلب تونس العاصمة، وأصبحت من أشهر دور العطور في المدينة. واليوم نصل إلى المملكة بمجموعتنا الكاملة.", "link_text": "قصة الدار", "link_url": story_url}, componentId: 'riha-heritage', position: 5} %}
